rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasExactFields() {
      let fields = [
        'content',
        'createdAt',
        'updatedAt',
        'deletedAt'
      ];
      return request.resource.data.keys().hasAll(fields)
        && request.resource.data.keys().hasOnly(fields);
    }

    function hasValidTypesAndContent() {
      return request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 10000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          request.resource.data.deletedAt == null
          || request.resource.data.deletedAt is timestamp
        );
    }

    match /users/{userId}/logs/{logId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && hasExactFields()
        && hasValidTypesAndContent()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.deletedAt == null;

      allow update: if isOwner(userId)
        && hasExactFields()
        && hasValidTypesAndContent()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && resource.data.deletedAt == null
        && (
          (
            request.resource.data.deletedAt == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'content',
              'updatedAt'
            ])
          )
          || (
            request.resource.data.deletedAt == request.time
            && request.resource.data.content == resource.data.content
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'updatedAt',
              'deletedAt'
            ])
          )
        );

      allow delete: if false;
    }

    function hasExactTrackerFields() {
      let fields = [
        'name', 'scheduleMode', 'startMinute', 'endMinute',
        'totalCharges', 'isActive', 'createdAt', 'updatedAt'
      ];
      return request.resource.data.keys().hasAll(fields)
        && request.resource.data.keys().hasOnly(fields);
    }

    function hasValidTrackerData() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.scheduleMode in ['all_day', 'custom_time']
        && request.resource.data.startMinute is int
        && request.resource.data.startMinute >= 0
        && request.resource.data.startMinute <= 1439
        && request.resource.data.endMinute is int
        && request.resource.data.endMinute >= 1
        && request.resource.data.endMinute <= 1440
        && request.resource.data.endMinute > request.resource.data.startMinute
        && request.resource.data.totalCharges is int
        && request.resource.data.totalCharges >= 1
        && request.resource.data.totalCharges <= 200
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId}/stackTrackers/{trackerId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && hasExactTrackerFields()
        && hasValidTrackerData()
        && request.resource.data.isActive == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId)
        && hasExactTrackerFields()
        && hasValidTrackerData()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'scheduleMode', 'startMinute', 'endMinute',
          'totalCharges', 'isActive', 'updatedAt'
        ]);
      allow delete: if false;
    }

    function hasExactStackEventFields() {
      let fields = [
        'trackerId', 'trackerName', 'eventType', 'periodDate',
        'chargeIndex', 'amount', 'occurredAt', 'createdAt'
      ];
      return request.resource.data.keys().hasAll(fields)
        && request.resource.data.keys().hasOnly(fields);
    }

    function hasValidStackEventData() {
      return request.resource.data.trackerId is string
        && request.resource.data.trackerId.size() > 0
        && request.resource.data.trackerName is string
        && request.resource.data.trackerName.size() > 0
        && request.resource.data.trackerName.size() <= 50
        && request.resource.data.eventType in ['charge', 'consume']
        && request.resource.data.periodDate is string
        && request.resource.data.periodDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.occurredAt is timestamp
        && request.resource.data.createdAt is timestamp
        && (
          (
            request.resource.data.eventType == 'charge'
            && request.resource.data.amount == 1
            && request.resource.data.chargeIndex is int
            && request.resource.data.chargeIndex >= 1
            && request.resource.data.chargeIndex <= 200
          )
          || (
            request.resource.data.eventType == 'consume'
            && request.resource.data.amount == -1
            && request.resource.data.chargeIndex == null
          )
        );
    }

    match /users/{userId}/stackEvents/{eventId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && hasExactStackEventFields()
        && hasValidStackEventData()
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
